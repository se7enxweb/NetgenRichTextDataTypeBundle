{
    "name": "se7enxweb/richtext-datatype-bundle",
    "description": "Rich text datatype bundle: lets Exponential Legacy edit and publish content with the rich text (ezrichtext) field type of Exponential Platform 5.x",
    "license": "GPL-2.0-only",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "Netgen",
            "homepage": "http://www.netgenlabs.com"
        },
        {
            "name": "7x",
            "email": "info@se7enx.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ibexa/core": "^5.0",
        "ibexa/fieldtype-richtext": "^5.0",
        "se7enxweb/legacy-bridge": "^5.0",
        "se7enxweb/ngsymfonytools": "v5.0.x-dev"
    },
    "replace": {
        "netgen/richtext-datatype-bundle": "self.version"
    },
    "autoload": {
        "psr-4": { "Netgen\\Bundle\\RichTextDataTypeBundle\\": "" }
    },
    "extra": {
        "branch-alias": {
            "dev-5.x": "5.0.x-dev"
        }
    }
}
